[init]
	defaultBranch = main

[core]
	editor = nano
	pager = delta
	excludesfile = ~/.gitignore_global
	whitespace = -trailing-space

[gpg]
	format = ssh

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[fetch]
	prune = true

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[merge]
	ff = false
	conflictstyle = zdiff3

[rebase]
	autosquash = true
	autostash = true

[rerere]
	enabled = true
	autoupdate = true

[mergetool]
	prompt = false
	keepBackup = false
	keepTemporaries = false
	writeToTemp = true

[diff]
	algorithm = histogram
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Catppuccin Macchiato

[status]
	showUntrackedFiles = all
	submoduleSummary = true

[log]
	abbrevCommit = true
	follow = true
	decorate = false

[grep]
	break = true
	heading = true
	lineNumber = true
	extendedRegexp = true

[color "branch"]
	upstream = cyan

[alias]
	aliases = "!git config --get-regexp '^alias\\.' | cut -c 7-"
	ci = commit
	cim = commit -m
	oops = commit --amend --no-edit
	reword = commit --amend
	uncommit = reset --soft HEAD~1
	fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -d' ' -f1 | xargs -o git commit --fixup"
	autosquash = rebase --keep-base --autosquash origin/HEAD
	co = checkout
	sw = switch
	cp = cherry-pick
	po = push origin
	pwl = push --force-with-lease
	ciaclean = "!git fetch -q && git for-each-ref --merged origin/HEAD --format='%(if)%(worktreepath)%(then)%(else)%(refname:short)%(end)' refs/heads | grep -vxE '(main|master|develop)?' | xargs -r -n 1 git branch -d"
	st = status -s
	lg = log --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ad)%Creset'
	lgt = log --graph --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ad)%Creset'
	stl = stash list
	sta = stash apply
	stp = stash pop
	sts = stash push -u

[include]
	path = ~/.gitconfig.local
