{
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  "buffer_font_family": "Google Sans Code",
  "buffer_font_size": 14.0,
  "buffer_font_weight": 300.0,
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15.0,
  "ui_font_weight": 300.0,

  "base_keymap": "VSCode",
  "format_on_save": "off",
  "prettier": {
    "allowed": true
  },
  "seed_search_query_from_cursor": "selection",
  "use_smartcase_search": true, // Let's try that
  "colorize_brackets": true,
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "gutter": {
    "min_line_number_digits": 3
  },
  "minimap": {
    "show": "never",
    "thumb_border": "right_open"
  },
  "scrollbar": {
    "show": "auto"
  },

  "tab_bar": {
    "show": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "preview_tabs": {
    "enabled": true
  },
  "toolbar": {
    "quick_actions": false
  },
  "status_bar": {
    "cursor_position_button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "debugger": {
    "button": false,
    "dock": "right"
  },
  "project_panel": {
    "button": false,
    "dock": "right",
    "default_width": 300,
    "auto_fold_dirs": false,
    "entry_spacing": "standard"
  },
  "git_panel": {
    "button": false,
    "dock": "right",
    "default_width": 300,
    "tree_view": true,
    "group_by": "staging",
    "sort_by": "path",
    "entry_primary_click_action": "file_diff"
  },
  "resize_all_panels_in_dock": ["left", "right", "bottom"],

  "git": {
    "file_diff": {
      "show_full_file": true
    }
  },
  "diff_view_style": "split",

  "terminal": {
    "button": false,
    "font_size": 12.0,
    "copy_on_select": true,
    "env": {
      "EDITOR": "zed --wait"
    }
  },
  "cli_default_open_behavior": "new_window",

  "disable_ai": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "zed"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_config_options": {
        "mode": "auto"
      },
      "favorite_config_option_values": {
        "mode": ["auto", "default"]
      }
    },
    "codex-acp": {
      "type": "registry"
    }
  },

  "auto_install_extensions": {
    "catppuccin-icons": true,
    "dockerfile": true,
    "git-firefly": true,
    "sql": true,
    "astro": false,
    "biome": false,
    "ruby": false,
    "svelte": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "profiles": {
    "Focus": {
      "settings": {
        "ui_font_size": 15,
        "buffer_font_size": 14,
        "centered_layout": {
          "left_padding": 0.1,
          "right_padding": 0.1
        },
        "current_line_highlight": "none",
        "project_panel": {
          "starts_open": false
        },
        "tab_bar": {
          "show": false,
          "show_nav_history_buttons": false
        },
        "status_bar": {
          "experimental.show": false
        },
        "toolbar": {
          "breadcrumbs": false,
          "quick_actions": false
        },
        "gutter": {
          "line_numbers": false,
          "folds": false,
          "breakpoints": false,
          "runnables": false,
          "min_line_number_digits": 0
        },
        "indent_guides": {
          "enabled": false
        },
        "scrollbar": {
          "show": "never",
          "cursors": false,
          "git_diff": false,
          "diagnostics": "none",
          "search_results": false,
          "selected_symbol": false
        }
      }
    }
  }
}
