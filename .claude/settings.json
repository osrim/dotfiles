{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "model": "opus",
  "modelPicker": {
    "options": [
      {
        "model": "claude-opus-4-8",
        "label": "Opus 4.8"
      },
      {
        "model": "claude-opus-4-6",
        "label": "Opus 4.6"
      }
    ]
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/strip-coauthor.sh\" rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/bin/bun --env-file /dev/null \"$HOME/.claude/plugins/claude-hud/statusline.mjs\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "worktrunk@worktrunk": true,
    "hemnet-cli@hemnet": false,
    "ast-grep@ast-grep-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true
}
